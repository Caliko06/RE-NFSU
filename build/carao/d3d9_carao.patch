+// BRIDGE: baked car AO, OWNER 2026-10-29 (remaster: volume for the kits). build/carao/carao.bin (tools/ao, Blender Cycles per-vertex AO of
+// every solid of the 20 kit cars) is { "CAO1", u32 n, n x { u64 key, u32 nv, u32 offset }, u8 AO blob }; key = FNV-1a 64 over the
+// 12 position bytes of vertices 0..nv-1 (the car draws are whole solids). The AO goes in the alpha byte of COLOR0, which car.efx does
+// not read (RideInfo's colour is 0xff000000 there): an unmatched draw keeps alpha 0xff = open. RN_CARAO=0 or no file = off.
+typedef struct { uint64_t key; uint32_t nv, off; } CaoEnt;
+static const uint8_t *cao_blob; static const CaoEnt *cao_tab; static uint32_t cao_n;
+static void cao_load(void) {
+    static int done;
+    if (done++) return;
+    const char *e = getenv("RN_CARAO"), *path = e ? e : "build/carao/carao.bin";
+    if (!strcmp(path, "0")) return;
+    FILE *f = fopen(path, "rb");
+    if (!f) return;
+    fseek(f, 0, SEEK_END); long n = ftell(f); fseek(f, 0, SEEK_SET);
+    uint8_t *b = malloc((size_t)n);
+    if (!b || fread(b, 1, (size_t)n, f) != (size_t)n || n < 8 || memcmp(b, "CAO1", 4)) { fclose(f); free(b); return; }
+    fclose(f);
+    memcpy(&cao_n, b + 4, 4);
+    cao_tab = (const CaoEnt *)(b + 8); cao_blob = b + 8 + 16 * (size_t)cao_n;   // CaoEnt is 16 bytes with its natural padding
+    rn_log("carao: %u solids from %s", cao_n, path);
+}
+static const uint8_t *cao_find(const uint8_t *vsrc, uint32_t stride, uint32_t po, uint32_t nvert) {
+    cao_load();
+    if (!cao_n) return NULL;
+    uint64_t h = 0xcbf29ce484222325ull;
+    for (uint32_t k = 0; k < nvert; k++) h = fnv64b(h, vsrc + (size_t)k * stride + po, 12);
+    uint32_t lo = 0, hi = cao_n;
+    while (lo < hi) { uint32_t m = (lo + hi) / 2; if (cao_tab[m].key < h) lo = m + 1; else hi = m; }
+    return lo < cao_n && cao_tab[lo].key == h && cao_tab[lo].nv == nvert ? cao_blob + cao_tab[lo].off : NULL;
+}
